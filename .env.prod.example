# Configuração da TrilhaCode em produção (docker-compose.prod.yml).
# Copie para .env.prod, preencha e nunca envie o arquivo preenchido para o repositório.

# Versão das imagens (ghcr.io/profabraaojr/trilhacode-*)
TRILHACODE_VERSION=1.0.1

# Endereços públicos: a interface e o sandbox precisam ser origens diferentes
# (dois subdomínios, ambos apontando para este servidor).
TRILHACODE_URL=https://trilha.escola.br
TRILHACODE_SANDBOX_URL=https://sandbox.trilha.escola.br

# E-mail para avisos do Let's Encrypt sobre os certificados (opcional)
ACME_EMAIL=

# Banco de dados: troque por uma senha longa e aleatória
POSTGRES_PASSWORD=

# Segredo das sessões, com 32 ou mais caracteres. Gere com:  openssl rand -base64 48
BETTER_AUTH_SECRET=

# Envio de e-mails (confirmação de cadastro, recuperação de senha, convites)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TrilhaCode <nao-responda@escola.br>

# Página de privacidade: instituição responsável e contato do encarregado de dados
TRILHACODE_INSTITUTION=
TRILHACODE_PRIVACY_CONTACT=
