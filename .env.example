# Copie para .env e ajuste se necessário: cp .env.example .env

# Banco de dados (o docker-compose usa estes mesmos valores)
POSTGRES_USER=trilhacode
POSTGRES_PASSWORD=trilhacode_dev
POSTGRES_DB=trilhacode
DATABASE_URL=postgres://trilhacode:trilhacode_dev@localhost:5432/trilhacode

# API
API_PORT=3000
API_HOST=127.0.0.1
# Origem da interface autorizada a chamar a API (CORS)
WEB_ORIGIN=http://localhost:5173

# E-mail (Mailpit em desenvolvimento; caixa de entrada em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# Sandbox de execução (Etapa 2). Em produção, publique apps/sandbox em outra origem
# (ex.: https://run.seudominio.org/) e informe a URL aqui ANTES do build da interface.
VITE_SANDBOX_URL=http://localhost:5174/

# Autenticação (Etapa 4)
# Segredo que assina sessões e tokens. Em produção, gere um valor próprio, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=troque-este-segredo-em-producao-por-um-valor-aleatorio
# Endereço público da plataforma, usado nos links dos e-mails (padrão: WEB_ORIGIN).
# A interface e a API devem ficar na mesma origem (ex.: /api atrás de um proxy reverso).
# PUBLIC_URL=https://trilhacode.seudominio.org

# E-mail: além de SMTP_HOST e SMTP_PORT (acima), em produção informe:
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="TrilhaCode <nao-responda@trilhacode.local>"
