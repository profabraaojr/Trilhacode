# Copie para .env e ajuste se necessário: cp .env.example .env

# Banco de dados (o docker-compose usa estes mesmos valores)
POSTGRES_USER=trilhacode
POSTGRES_PASSWORD=trilhacode_dev
POSTGRES_DB=trilhacode
DATABASE_URL=postgres://trilhacode:trilhacode_dev@localhost:5432/trilhacode

# API
API_PORT=3000
API_HOST=127.0.0.1
# Origem da interface autorizada a chamar a API (CORS)
WEB_ORIGIN=http://localhost:5173

# E-mail (Mailpit em desenvolvimento; caixa de entrada em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
