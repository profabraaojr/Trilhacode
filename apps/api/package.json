{
  "name": "@trilhacode/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "NODE_OPTIONS=--conditions=source drizzle-kit generate",
    "db:migrate": "tsx --conditions=source --env-file-if-exists=../../.env src/db/migrate.ts",
    "content:sync": "tsx --conditions=source --env-file-if-exists=../../.env src/content/sync.ts ../../content",
    "admin:criar": "tsx --conditions=source --env-file-if-exists=../../.env src/admin/promote.ts",
    "admin:papel": "tsx --conditions=source --env-file-if-exists=../../.env src/admin/promote.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@trilhacode/content": "workspace:*",
    "@trilhacode/shared": "workspace:*",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  }
}
