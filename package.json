{
  "name": "trilhacode",
  "private": true,
  "version": "0.5.0",
  "description": "Plataforma educacional de programação de código aberto",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @trilhacode/web test:e2e",
    "db:generate": "pnpm --filter @trilhacode/api db:generate",
    "db:migrate": "pnpm --filter @trilhacode/api db:migrate",
    "content:validate": "pnpm --filter @trilhacode/content validate",
    "content:links": "pnpm --filter @trilhacode/content links",
    "content:sync": "pnpm --filter @trilhacode/api content:sync",
    "admin:criar": "pnpm --filter @trilhacode/api admin:criar",
    "admin:papel": "pnpm --filter @trilhacode/api admin:papel"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
